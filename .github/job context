name: PostgreSQL Service Example
on: push
jobs:
  postgres-job:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: testdb
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432   # نگاشت پورت ثابت (اختیاری) یا می‌توانید از پورت تصادفی استفاده کنید
    steps:
      - name: Install PostgreSQL client
        run: sudo apt-get update && sudo apt-get install -y postgresql-client

      - name: Wait for PostgreSQL to be ready
        run: |
          for i in {1..10}; do
            if pg_isready -h localhost -p ${{ job.services.postgres.ports[5432] }} -U postgres; then
              echo "PostgreSQL is ready"
              break
            fi
            sleep 2
          done

      - name: Set PostgreSQL port as environment variable
        run: echo "PGPORT=${{ job.services.postgres.ports[5432] }}" >> $GITHUB_ENV

      - name: Run tests against PostgreSQL
        run: |
          psql -h localhost -p $PGPORT -U postgres -d testdb -c "SELECT version();"
          # دستورات تست‌های خود را اینجا اجرا کنید